<li class="nav-item dropdown">
    <a class="nav-link" data-bs-toggle="dropdown" href="#" aria-label="Notifications">
        <i class="{{ icon }}"></i>
        {% if badge %}<span class="navbar-badge badge {{ badgeClass }}">{{ badge }}</span>{% endif %}
    </a>
    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
        <span class="dropdown-item dropdown-header">{{ items|length }} Notifications</span>
        <div class="dropdown-divider"></div>
        {% for item in items %}
            <a href="{{ item.url ?? '#' }}" class="dropdown-item">
                {% if item.icon ?? false %}<i class="{{ item.icon }} me-2"></i>{% endif %}{{ item.text }}
                {% if item.time ?? false %}<span class="float-end text-body-secondary fs-7">{{ item.time }}</span>{% endif %}
            </a>
            <div class="dropdown-divider"></div>
        {% endfor %}
        <a href="{{ footerUrl ?? '#' }}" class="dropdown-item dropdown-footer">{{ footerText }}</a>
    </div>
</li>
