<div class="{{ this.cardClass }}">
    {% if title or collapsible or removable %}
        <div class="card-header">
            {% if title %}
                <h3 class="card-title">
                    {% if icon %}<i class="{{ icon }} me-2"></i>{% endif %}{{ title }}
                </h3>
            {% endif %}
            {% if collapsible or removable %}
                <div class="card-tools">
                    {% if collapsible %}
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse" aria-label="Collapse card">
                            <i class="bi {{ collapsed ? 'bi-plus-lg' : 'bi-dash-lg' }}"></i>
                        </button>
                    {% endif %}
                    {% if removable %}
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-remove" aria-label="Remove card">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}
    <div class="card-body{{ bodyClass ? ' ' ~ bodyClass }}">
        {% block content %}{% endblock %}
    </div>
    {% if footer %}
        <div class="card-footer">{{ footer|raw }}</div>
    {% endif %}
</div>
