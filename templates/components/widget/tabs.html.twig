<div class="card">
    <div class="card-header p-0 border-bottom-0">
        <ul class="nav nav-tabs" id="{{ id }}_tabs" role="tablist">
            {% for item in items %}
                {% set active = item.active ?? loop.first %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link{{ active ? ' active' }}" id="{{ id }}_{{ item.id }}_tab"
                            data-bs-toggle="tab" data-bs-target="#{{ id }}_{{ item.id }}" type="button"
                            role="tab" aria-controls="{{ id }}_{{ item.id }}" aria-selected="{{ active ? 'true' : 'false' }}">
                        {{ item.title }}
                    </button>
                </li>
            {% endfor %}
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content" id="{{ id }}_content">
            {% for item in items %}
                {% set active = item.active ?? loop.first %}
                <div class="tab-pane fade{{ active ? ' show active' }}" id="{{ id }}_{{ item.id }}"
                     role="tabpanel" aria-labelledby="{{ id }}_{{ item.id }}_tab" tabindex="0">
                    {{ (item.content ?? '')|raw }}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
