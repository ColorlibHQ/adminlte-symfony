<div class="modal fade" id="{{ id }}" tabindex="-1" aria-labelledby="{{ id }}_label" aria-hidden="true">
    <div class="{{ this.dialogClass }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ id }}_label">{{ title }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">{% block content %}{% endblock %}</div>
            {% if footer %}<div class="modal-footer">{{ footer|raw }}</div>{% endif %}
        </div>
    </div>
</div>
