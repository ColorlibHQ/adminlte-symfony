{% set field_id = this.fieldId %}
<div class="form-check form-switch mb-3">
    <input class="form-check-input" type="checkbox" role="switch" id="{{ field_id }}" name="{{ name }}"
           value="{{ value }}"{{ checked ? ' checked' }}{{ required ? ' required' }}>
    {% if label %}<label class="form-check-label" for="{{ field_id }}">{{ label }}</label>{% endif %}
</div>
