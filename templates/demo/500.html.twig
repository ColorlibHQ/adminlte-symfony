{#
    Standalone 500 error page — mirrors AdminLTE core `pages/500.html`.

    Self-contained: does NOT extend @AdminLte/layout.html.twig. Wire it from a
    controller (or use it as the Symfony error template), e.g.:

        return $this->render('@AdminLte/demo/500.html.twig');
#}
<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>500 Error · AdminLTE 4 · Symfony</title>
    {{ include('@AdminLte/components/layout/_color_mode_script.html.twig') }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.2/dist/css/adminlte.min.css">
</head>
<body class="bg-body-tertiary">
    <main class="d-flex align-items-center min-vh-100 py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6 text-center">
                    <div class="display-1 fw-bold text-danger lh-1 mb-3">500</div>
                    <h1 class="h3 mb-3">Something went wrong on our end.</h1>
                    <p class="text-secondary mb-4">
                        The server encountered an unexpected condition. Our team has been notified. Please try
                        again in a moment, or contact support if the issue persists.
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                            Back to dashboard
                        </a>
                        <a href="mailto:support@example.com" class="btn btn-outline-secondary">
                            <i class="bi bi-life-preserver me-1" aria-hidden="true"></i>
                            Contact support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.2/dist/js/adminlte.min.js"></script>
</body>
</html>
