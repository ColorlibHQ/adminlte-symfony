{#
    UI Icons — Bootstrap Icons grid. The core dist/ui/icons.html only links to
    icon libraries; this page additionally renders a browsable grid of the
    Bootstrap Icons that ship with the bundle layout.

    Wire it from a controller:

        #[Route('/admin/ui/icons', name: 'adminlte_demo_ui_icons')]
        public function icons(): Response
        {
            return $this->render('@AdminLte/demo/ui-icons.html.twig');
        }
#}
{% extends '@AdminLte/demo/_layout.html.twig' %}

{% block title %}Icons · {{ adminlte.title }}{% endblock %}
{% block page_title %}Icons{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item">UI Elements</li>
        <li class="breadcrumb-item active" aria-current="page">Icons</li>
    </ol>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <twig:Adminlte:Card title="Icons" variant="primary" outline>
                <p>The bundle ships with <a href="https://icons.getbootstrap.com/" target="_blank"
                   rel="noopener noreferrer">Bootstrap Icons</a>, but you can use any font
                   library you like with AdminLTE 4.</p>
                <strong>Recommendations</strong>
                <ul class="mt-1">
                    <li><a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener noreferrer">Bootstrap Icons</a></li>
                    <li><a href="https://fontawesome.com/" target="_blank" rel="noopener noreferrer">Font Awesome</a></li>
                    <li><a href="https://ionicons.com/" target="_blank" rel="noopener noreferrer">Ion Icons</a></li>
                </ul>
            </twig:Adminlte:Card>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <twig:Adminlte:Card title="Bootstrap Icons" variant="info" outline>
                <div class="row g-3 text-center">
                    {% set icons = [
                        'alarm', 'archive', 'arrow-clockwise', 'bag-fill', 'bar-chart-fill',
                        'bell-fill', 'bookmark-star', 'box-seam', 'briefcase-fill', 'calendar3',
                        'camera-fill', 'cart-fill', 'chat-dots-fill', 'check-circle-fill', 'clipboard-data',
                        'cloud-arrow-up-fill', 'code-slash', 'cpu-fill', 'credit-card-2-front', 'cursor-fill',
                        'database-fill', 'download', 'envelope-fill', 'eye-fill', 'file-earmark-text',
                        'flag-fill', 'folder-fill', 'gear-fill', 'gift-fill', 'globe',
                        'graph-up-arrow', 'grid-3x3-gap-fill', 'hand-thumbs-up-fill', 'heart-fill', 'house-door-fill',
                        'image-fill', 'inbox-fill', 'key-fill', 'lightbulb-fill', 'lightning-charge-fill',
                        'link-45deg', 'list-check', 'lock-fill', 'map-fill', 'megaphone-fill',
                        'pencil-square', 'people-fill', 'person-circle', 'phone-fill', 'pie-chart-fill',
                        'pin-map-fill', 'printer-fill', 'search', 'shield-lock-fill', 'star-fill',
                        'tag-fill', 'trash-fill', 'trophy-fill', 'truck', 'upload',
                        'wallet2', 'wifi', 'window-stack', 'x-circle-fill'
                    ] %}
                    {% for icon in icons %}
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <div class="border rounded p-3 h-100">
                                <i class="bi bi-{{ icon }} fs-3 d-block mb-2"></i>
                                <small class="text-body-secondary d-block text-truncate">bi-{{ icon }}</small>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </twig:Adminlte:Card>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <twig:Adminlte:Card title="Icon Sizes &amp; Colors" variant="success" outline>
                <p class="mb-2">Scale icons with Bootstrap font-size utilities and colour them with text utilities.</p>
                <div class="d-flex align-items-end flex-wrap gap-3 mb-3">
                    <i class="bi bi-star-fill fs-6"></i>
                    <i class="bi bi-star-fill fs-5"></i>
                    <i class="bi bi-star-fill fs-4"></i>
                    <i class="bi bi-star-fill fs-3"></i>
                    <i class="bi bi-star-fill fs-2"></i>
                    <i class="bi bi-star-fill fs-1"></i>
                </div>
                <div class="d-flex flex-wrap gap-3 fs-3">
                    <i class="bi bi-heart-fill text-primary"></i>
                    <i class="bi bi-heart-fill text-secondary"></i>
                    <i class="bi bi-heart-fill text-success"></i>
                    <i class="bi bi-heart-fill text-danger"></i>
                    <i class="bi bi-heart-fill text-warning"></i>
                    <i class="bi bi-heart-fill text-info"></i>
                    <i class="bi bi-heart-fill text-dark"></i>
                </div>
            </twig:Adminlte:Card>
        </div>
    </div>
{% endblock %}
